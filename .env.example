# Copy this file to .env and fill in real values. Never commit .env.
# SQLite for local development. The file is created on first migrate.
DATABASE_URL="file:./dev.db"
# Postgres for production, for example Neon. Set this instead of the file URL.
# DATABASE_URL="postgresql://user:password@host:5432/mpark?sslmode=require"
# Long random string used to sign session cookies. Generate one per install.
SESSION_SECRET="change-me-to-a-long-random-string"
# Public base URL used to build QR scan links, for example https://m-park.example
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# SMS provider. Leave empty in development: OTP codes are logged and shown
# on screen in dev mode only, clearly labelled. For production set one of:
# SMS_PROVIDER="twilio" and TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM
# SMS_PROVIDER="jazz" and provider keys, or your Pakistan SMS gateway keys.
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Payment provider. Subscriptions are created by the admin in the dashboard.
# For live online payment set a provider and its keys here, for example JazzCash
# or Easypaisa merchant credentials, or Stripe. No payment keys are in this repo.
PAYMENT_PROVIDER=""
PAYMENT_MERCHANT_ID=""
PAYMENT_SECRET=""
